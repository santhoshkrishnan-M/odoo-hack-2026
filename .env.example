# Copy to .env (or set these in your host). Everything is optional for local use.

# Database. Leave empty to use the embedded PostgreSQL (PGlite) stored in ./data/pglite.
# For Neon / any PostgreSQL: postgresql://user:password@host/db?sslmode=require
DATABASE_URL=

# How many demo subscriptions to create on first start (empty database only).
SEED_SUBSCRIPTIONS=1000

# Public URL used in emails (payment links, password resets). Defaults to the request's host.
APP_URL=http://localhost:5173

# Online payments with Razorpay (test or live keys). Without them a built-in test gateway is used.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email delivery. Without SMTP_URL every email is still written to the email log (Admin → Email log).
# Example: smtps://user:password@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM="Brightloop Billing <billing@example.com>"

# Production only
# CRON_SECRET=      Vercel Cron sends it as a Bearer token to /api/cron/daily
# SETUP_SECRET=     lets POST /api/setup?key=... load the demo company into an empty production database
# SCHEDULER=off     disables the in-process hourly automation timer (when an external cron runs it)
# DEV_MAILBOX=1     shows the demo mailbox page in production (never on a public server)
